{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/cli.ts",
    "src/flowDiff.ts",
    "src/sfJson.ts",
    "src/unifiedTable.ts",
    "src/versionLabel.ts"
  ],
  "exclude": ["node_modules", "out"]
}
